+    requires p2y == anchor_y for the ``180 - angle`` supplement identity to
+    hold and must keep using the collinear ``_frame()``.
+    """
+    return pd.DataFrame(
+        {
+            "x_class0": [500.0],
+            "y_class0": [540.0],
+            "x_class1": [550.0],
+            "y_class1": [500.0],
+        }
+    )
+
+
