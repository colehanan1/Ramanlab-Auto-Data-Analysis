+    settings_all = _StubSettings(thawed=(), thaw_all=True)
+    assert rw._thaw_cli_args(settings_all) == ["--thaw-all"]
+
+    settings_none = _StubSettings()
+    assert rw._thaw_cli_args(settings_none) == []
