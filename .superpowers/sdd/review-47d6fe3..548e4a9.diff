+def test_score_summary_parse_args_thaw_and_thaw_all(tmp_path):
+    args = ss._parse_args(
+        [
+            "--csv-path", str(tmp_path / "scores.csv"),
+            "--out-dir", str(tmp_path / "out"),
+            "--config", "x",
+            "--thaw", "DS",
+            "--thaw-all",
+        ]
+    )
+    assert args.thaw == ["DS"]
+    assert args.thaw_all is True
